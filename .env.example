# Contentful Space ID
CONTENTFUL_SPACE_ID=your_space_id_here

# Contentful environment (defaults to master)
CONTENTFUL_ENVIRONMENT=master

# Contentful Content Delivery API (CDA) token
CONTENTFUL_DELIVERY_TOKEN=your_delivery_token_here

# Public site URL, used for canonical URLs, sitemap, robots.txt and Schema.org
NUXT_PUBLIC_SITE_URL=https://www.example.com

# Coach identity, shown on the site and used in SEO and Schema.org.
# Full name: header, footer, copyright, page titles, structured data
NUXT_PUBLIC_COACH_NAME=Nombre Apellido
# First name: home page greeting ("Hola, soy ...")
NUXT_PUBLIC_COACH_FIRST_NAME=Nombre

# Social profiles (footer links and Schema.org sameAs). Leave empty to hide one.
NUXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your_profile
NUXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your_profile

# Contact form (Web3Forms, https://web3forms.com). The access key is public by design.
NUXT_PUBLIC_WEB3FORMS_URL=https://api.web3forms.com/submit
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here
